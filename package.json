{
  "name": "arias-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "local:check": "node scripts/check-local-environment.mjs",
    "dev:local": "node scripts/check-local-environment.mjs && vite --host 127.0.0.1",
    "validate:navigation": "node --test scripts/validate-navigation.test.mjs",
    "validate:books": "node --test scripts/validate-technical-books.test.mjs scripts/validate-technical-books-ui.test.mjs",
    "validate:activity": "node --test scripts/validate-demo-activity.test.mjs",
    "validate:access-log": "node --test scripts/validate-access-log.test.mjs",
    "validate:demo": "node --test scripts/validate-demo-read-only.test.mjs",
    "validate:modules": "node --test scripts/validate-modules.test.mjs scripts/check-local-environment.test.mjs",
    "validate:books:database": "node scripts/validate-technical-books-database.test.mjs",
    "validate:preventives": "node --test scripts/validate-preventive-schedule.test.mjs scripts/validate-book-ticket.test.mjs && node scripts/validate-preventive-database.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.116.0",
    "dayjs": "^1.11.23",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
